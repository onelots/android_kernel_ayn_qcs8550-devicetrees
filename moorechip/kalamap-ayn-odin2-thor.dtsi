// TODO: ???
&L1B {
	regulator-always-on;
};

&L14B {
	regulator-min-microvolt = <3000000>;
	regulator-max-microvolt = <3000000>;
	qcom,init-voltage = <3000000>;
};

&joystick {
	moorechip,layout-nintendo;
};

&pm8550_rgb {
	status = "disabled";
};