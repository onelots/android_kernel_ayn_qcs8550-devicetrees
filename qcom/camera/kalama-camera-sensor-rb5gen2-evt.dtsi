&cam_cci2 {

    actuator_rear_cam8: qcom,actuator8 {
        cell-index = <8>;
        compatible = "qcom,actuator";
        cci-master = <0>;
        cam_vaf-supply = <&L15B>;
        regulator-names = "cam_vaf";
        rgltr-cntrl-support;
        rgltr-min-voltage = <1800000>;
        rgltr-max-voltage = <1800000>;
        rgltr-load-current = <120000>;
    };

    eeprom_rear_cam8: qcom,eeprom2 {
        cell-index = <8>;
        compatible = "qcom,eeprom";
        cam_vio-supply = <&L15B>;
        cam_clk-supply = <&cam_cc_titan_top_gdsc>;
        regulator-names = "cam_vio", "cam_clk";
        rgltr-cntrl-support;
        pwm-switch;
        rgltr-min-voltage = <1800000 0>;
        rgltr-max-voltage = <1800000 0>;
        rgltr-load-current = <120000 0>;
        gpio-no-mux = <0>;
        pinctrl-names = "cam_default", "cam_suspend";
        pinctrl-0 = <&cam_sensor_mclk6_active
                 &cam_sensor_active_rst6
                 &cam_sensor_active_rst9>;
        pinctrl-1 = <&cam_sensor_mclk6_suspend
                 &cam_sensor_suspend_rst6
                 &cam_sensor_suspend_rst9>;
        gpios = <&tlmm 106 0>,
                <&tlmm 109 0>,
                <&tlmm 10 0>;
        gpio-reset = <1>;
        gpio-standby = <2>;
        gpio-req-tbl-num = <0 1 2>;
        gpio-req-tbl-flags = <1 0 0>;
        gpio-req-tbl-label = "CAMIF_MCLK6",
                    "CAM_RESET6",
                    "CAM_STANDBY";
        sensor-mode = <0>;
        cci-master = <0>;
        status = "ok";
        clocks = <&camcc CAM_CC_MCLK6_CLK>;
        clock-names = "cam_clk";
        clock-cntl-level = "turbo";
        clock-rates = <24000000>;
    };

    qcom,cam-sensor8 {
        cell-index = <8>;
        compatible = "qcom,cam-sensor";
        csiphy-sd-index = <1>;
        sensor-position-roll = <270>;
        sensor-position-pitch = <0>;
        sensor-position-yaw = <0>;
        actuator-src = <&actuator_rear_cam8>;
        eeprom-src = <&eeprom_rear_cam8>;
        cam_vio-supply = <&L15B>;

        cam_clk-supply = <&cam_cc_titan_top_gdsc>;
        regulator-names = "cam_vio",  "cam_clk";
        rgltr-cntrl-support;
        pwm-switch;
        rgltr-min-voltage = <1800000 0>;
        rgltr-max-voltage = <1800000 0>;
        rgltr-load-current = <120000 0>;
        gpio-no-mux = <0>;
        pinctrl-names = "cam_default", "cam_suspend";
        pinctrl-0 = <&cam_sensor_mclk6_active
                 &cam_sensor_active_rst6
                 &cam_sensor_active_rst9>;
        pinctrl-1 = <&cam_sensor_mclk6_suspend
                 &cam_sensor_suspend_rst6
                 &cam_sensor_suspend_rst9>;
        gpios = <&tlmm 106 0>,
                <&tlmm 109 0>,
                <&tlmm 10 0>;
        gpio-reset = <1>;
        gpio-standby = <2>;
        gpio-req-tbl-num = <0 1 2>;
        gpio-req-tbl-flags = <1 0 0>;
        gpio-req-tbl-label = "CAMIF_MCLK6",
                    "CAM_RESET6",
                    "CAM_STANDBY";
        sensor-mode = <0>;
        cci-master = <0>;
        status = "ok";
        clocks = <&camcc CAM_CC_MCLK6_CLK>;
        clock-names = "cam_clk";
        clock-cntl-level = "turbo";
        clock-rates = <24000000>;
    };

    actuator_rear_cam9: qcom,actuator9 {
        cell-index = <9>;
        compatible = "qcom,actuator";
        cci-master = <1>;
        cam_vaf-supply = <&L15B>;
        regulator-names = "cam_vaf";
        rgltr-cntrl-support;
        rgltr-min-voltage = <1800000>;
        rgltr-max-voltage = <1800000>;
        rgltr-load-current = <120000>;
    };

    eeprom_rear_cam9: qcom,eeprom1 {
        cell-index = <9>;
        compatible = "qcom,eeprom";
        cam_vio-supply = <&L15B>;
        cam_clk-supply = <&cam_cc_titan_top_gdsc>;
        regulator-names = "cam_vio", "cam_clk";
        rgltr-cntrl-support;
        pwm-switch;
        rgltr-min-voltage = <1800000 0>;
        rgltr-max-voltage = <1800000 0>;
        rgltr-load-current = <120000 0>;
        gpio-no-mux = <0>;
        pinctrl-names = "cam_default", "cam_suspend";
        pinctrl-0 = <&cam_sensor_mclk7_active
                 &cam_sensor_active_rst7
                 &cam_sensor_active_rst10>;
        pinctrl-1 = <&cam_sensor_mclk7_suspend
                 &cam_sensor_suspend_rst7
                 &cam_sensor_suspend_rst10>;
        gpios = <&tlmm 107 0>,
            <&tlmm 72 0>,
            <&tlmm 62 0> ;
        gpio-reset = <1>;
        gpio-standby = <2>;
        gpio-req-tbl-num = <0 1 2>;
        gpio-req-tbl-flags = <1 0 0>;
        gpio-req-tbl-label = "CAMIF_MCLK7",
                    "CAM_RESET7",
                    "CAM_STANDBY";
        sensor-mode = <0>;
        cci-master = <1>;
        status = "ok";
        clocks = <&camcc CAM_CC_MCLK7_CLK>;
        clock-names = "cam_clk";
        clock-cntl-level = "turbo";
        clock-rates = <24000000>;
    };

    qcom,cam-sensor9 {
        cell-index = <9>;
        compatible = "qcom,cam-sensor";
        csiphy-sd-index = <3>;
        sensor-position-roll = <90>;
        sensor-position-pitch = <0>;
        sensor-position-yaw = <180>;
        actuator-src = <&actuator_rear_cam9>;
        eeprom-src = <&eeprom_rear_cam9>;
        cam_vio-supply = <&L15B>;
        cam_clk-supply = <&cam_cc_titan_top_gdsc>;
        regulator-names = "cam_vio","cam_clk";
        rgltr-cntrl-support;
        pwm-switch;
        rgltr-min-voltage = <1800000   0>;
        rgltr-max-voltage = <1800000   0>;
        rgltr-load-current = <120000   0>;
        gpio-no-mux = <0>;
        pinctrl-names = "cam_default", "cam_suspend";
        pinctrl-0 = <&cam_sensor_mclk7_active
                 &cam_sensor_active_rst7
                 &cam_sensor_active_rst10>;
        pinctrl-1 = <&cam_sensor_mclk7_suspend
                 &cam_sensor_suspend_rst7
                 &cam_sensor_suspend_rst10>;
        gpios = <&tlmm 107 0>,
            <&tlmm 72 0>,
            <&tlmm 62 0> ;
        gpio-reset = <1>;
        gpio-standby = <2>;
        gpio-req-tbl-num = <0 1 2>;
        gpio-req-tbl-flags = <1 0 0>;
        gpio-req-tbl-label = "CAMIF_MCLK7",
                    "CAM_RESET7",
                    "CAM_STANDBY";
        sensor-mode = <0>;
        cci-master = <1>;
        status = "ok";
        clocks = <&camcc CAM_CC_MCLK7_CLK>;
        clock-names = "cam_clk";
        clock-cntl-level = "turbo";
        clock-rates = <24000000>;
    };
};
